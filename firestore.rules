rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All user data lives under users/{userId}. Only that signed-in user may access it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User-submitted bug reports / requests / feedback (append-only).
    match /feedbackReports/{docId} {
      // Do not use keys().hasOnly() including createdAt: serverTimestamp() placeholders
      // can fail that check during evaluation and deny valid creates.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['bug', 'request', 'feedback']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 8000;
      allow read, update, delete: if false;
    }
  }
}
